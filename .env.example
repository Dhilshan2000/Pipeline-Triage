# -----------------------------------------------------------------------------
# Pipeline Triage - Environment Configuration
# -----------------------------------------------------------------------------

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=generate_with_fernet_generate_key_here
FERNET_MASTER_KEY=o41k56sYJg3i49Vb7B3m0XwF8YnZ1Q2w3E4r5T6y7U8=

# Databases
MONGODB_URI=mongodb://root:example_password@mongo:27017/pipeline_triage?authSource=admin
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# LLM Configuration (Swappable behind one LLMProvider interface)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=45

# Embedding & Reranker Models (Local / Open-Source)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Email / Mailpit (Dev SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pipeline-triage@example.com

# External Service Credentials (Sandbox / Test defaults)
SONARQUBE_URL=http://host.docker.internal:9000
SONARQUBE_TRIAGE_BOT_TOKEN=

GITLAB_WEBHOOK_SECRET=gitlab_shared_webhook_secret_123
GITHUB_WEBHOOK_SECRET=github_shared_webhook_secret_456

# Kanvaro Mock MCP Server
KANVARO_MCP_URL=http://mock-kanvaro:8080/sse
KANVARO_BOT_USER=triage-bot
KANVARO_BOT_PASSWORD=mock_kanvaro_secure_pass

# Web App / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_nextauth_jwt_key_32chars_min
NEXT_PUBLIC_API_URL=http://localhost:8000
